# FormEasy Apps Script web app URL (Deploy > Manage deployments > Web app URL)
VITE_FORMEASY_URL=

# Canonical site origin for SEO (canonical, sitemap, JSON-LD). No trailing slash.
VITE_SITE_URL=https://air.gyrogovernance.com

# Optional override for the Craft project list markdown (default: raw GitHub AIR-Craft.md).
# Used at build time (sync-air-craft) and optionally at runtime on /craft.
# VITE_AIR_CRAFT_MD_URL=https://raw.githubusercontent.com/gyrogovernance/air-craft/main/AIR-Craft.md
# AIR_CRAFT_MD_URL=https://raw.githubusercontent.com/gyrogovernance/air-craft/main/AIR-Craft.md
